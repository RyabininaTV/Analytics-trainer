{
  "openapi" : "3.1.0",
  "components" : {
    "schemas" : {
      "LoginRequest" : {
        "type" : "object",
        "required" : [ "email", "password" ],
        "properties" : {
          "email" : {
            "type" : "string",
            "pattern" : "\\S",
            "maxLength" : 255
          },
          "password" : {
            "type" : "string",
            "pattern" : "\\S",
            "maxLength" : 100
          }
        }
      },
      "LogoutRequest" : {
        "type" : "object",
        "properties" : {
          "refresh_token" : {
            "type" : "string"
          }
        }
      },
      "RefreshRequest" : {
        "type" : "object",
        "required" : [ "refresh_token" ],
        "properties" : {
          "refresh_token" : {
            "type" : "string",
            "pattern" : "\\S"
          }
        }
      },
      "RegisterRequest" : {
        "type" : "object",
        "required" : [ "email", "username", "password" ],
        "properties" : {
          "email" : {
            "type" : "string",
            "pattern" : "\\S",
            "maxLength" : 255
          },
          "username" : {
            "type" : "string",
            "pattern" : "\\S",
            "minLength" : 3,
            "maxLength" : 100
          },
          "password" : {
            "type" : "string",
            "pattern" : "\\S",
            "minLength" : 8,
            "maxLength" : 100
          }
        }
      },
      "SubmitAttemptRequest" : {
        "type" : "object",
        "required" : [ "task_id", "answer" ],
        "properties" : {
          "task_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "user_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "answer" : {
            "type" : "string"
          }
        }
      }
    }
  },
